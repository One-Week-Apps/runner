{
  "name": "one-week-apps-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Runs iOS tasks on your Mac with Claude Code: build, UI tests, screenshots and a report you answer with OK or KO.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/One-Week-Apps/runner.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pair": "tsx src/pair.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.0.5"
  }
}
